PORT=3000
NODE_ENV=production
# Naming convention:
# - Dev:  dev_timeflow_enterprise_db  (Tenants: dev_timeflow_enterprise_<slug>_db)
# - Prod: timeflow_enterprise_db      (Tenants: timeflow_enterprise_<slug>_db)
DB_NAME=timeflow_enterprise_db
DATABASE_URL=postgresql://user:password@host:5432/timeflow_enterprise_db?sslmode=require
MASTER_DATABASE_URL=postgresql://user:password@host:5432/timeflow_enterprise_master_db?sslmode=require
REDIS_URL=
CACHE_MAX_ENTRIES=5000
MAX_TENANT_POOLS=60
TENANT_DB_POOL_MAX=10
TENANT_POOL_IDLE_MS=900000
TENANT_ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ENCRIPTION_SECRET=
GOOGLE_CLIENT_ID=
EMAIL_USER=
EMAIL_PASS=
FRONTEND_URL=https://timeflow.ijse.shamodha.com
API_RATE_LIMIT_MAX=300
